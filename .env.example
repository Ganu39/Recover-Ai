# ==============================================================================
# RecoverAI - Environment Configuration Template (Phase 0)
# ==============================================================================
# IMPORTANT:
# - Do NOT put real secrets in this file.
# - Copy this file to .env for local development.
# - Razorpay integration and credentials are NOT configured in Phase 0.
# ==============================================================================

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Database Configuration (PostgreSQL connection placeholder)
# Note: Full schema and tables will be defined in Phase 1.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai

# Frontend Service Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# Razorpay Test Mode Configuration (Test Mode Only)
# IMPORTANT: Only 'rzp_test_...' keys are permitted. Live credentials are strictly rejected.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ENV=test


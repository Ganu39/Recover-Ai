# ==============================================================================
# RecoverAI - Environment Configuration Template (Phase 0)
# ==============================================================================
# IMPORTANT:
# - Do NOT put real secrets in this file.
# - Copy this file to .env for local development.
# - Razorpay integration and credentials are NOT configured in Phase 0.
# ==============================================================================

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Database Configuration (PostgreSQL connection placeholder)
# Note: Full schema and tables will be defined in Phase 1.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai

# Frontend Service Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
